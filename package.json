{
	"name": "manhwa-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Web client for manhwa-api",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"index.html\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"index.html\"",
		"check": "npm run typecheck && npm run build"
	},
	"dependencies": {
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router-dom": "7.18.3"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"prettier": "3.9.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "8.2.2"
	}
}
