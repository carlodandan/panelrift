# Base URL of the manhwa-api worker.
#
# Leave this unset for both dev and production:
#   dev         vite proxies /api/* to the worker on 127.0.0.1:8787
#   production  functions/api/[[path]].ts forwards /api/* to the worker over a
#               service binding, same-origin
#
# Set it only to point the browser straight at a deployed worker, and note the
# worker's ALLOWED_ORIGINS allowlist will refuse http://localhost:5173 unless you
# add it there too.
# VITE_API_BASE_URL=https://manhwa-api.example.workers.dev
